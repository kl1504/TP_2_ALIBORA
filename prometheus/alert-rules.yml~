groups:
  - name: node_alerts
    rules:
      - alert: HighCpuLoad
        expr: 100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[1m])) * 100) > 10
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "High CPU load on {{ $labels.instance }}"
          description: "CPU load is > 10% (current value: {{ $value }}%)"

  - name: disk_alerts
    rules:
      - alert: DiskSpaceHigh
        expr: (node_filesystem_size_bytes{fstype!~"tmpfs|overlay"} 
               - node_filesystem_free_bytes{fstype!~"tmpfs|overlay"}) 
              / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"} > 0.20
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Espace disque élevé sur {{ $labels.instance }}"
          description: "Le disque {{ $labels.mountpoint }} dépasse 95% d'utilisation."

   groups:
  - name: instance_alerts
    rules:
      - alert: InstanceDown
        expr: up == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Instance {{ $labels.instance }} indisponible"
          description: "L'instance {{ $labels.instance }} ne répond plus depuis 2 minutes."
